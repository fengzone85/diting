{
  "name": "diting-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-assets.js && vue-tsc -b && vite build && node scripts/patch-css.js",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build:no-clean": "vue-tsc -b && vite build && node scripts/patch-css.js"
  },
  "dependencies": {
    "@icon-park/vue-next": "^1.4.2",
    "echarts": "^6.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^15.15.0",
    "jsdom": "^24.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.0.29"
  }
}
