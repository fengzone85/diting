[Unit]
Description=diting monitor server
After=network.target

[Service]
Type=simple
User=feng
# 运行目录分离（L2，2026-11-12）：运行副本与配置均在仓库树外——
#   代码+依赖+构建产物 = /data/simple-probe-data/server-data/app（`diting.sh --deploy-server` 同步）
#   配置 .env          = /data/simple-probe-data/server-data/.env（0600）
# `-` 前缀表示文件缺失时不阻断启动（server.js 的 dotenv 仍有兜底）。
EnvironmentFile=-/data/simple-probe-data/server-data/.env
WorkingDirectory=/data/simple-probe-data/server-data/app
ExecStart=/usr/local/bin/node server.js
# Restart=always（2026-10-26 由 on-failure 改）：on-failure 只覆盖「非零退出」，
# 而 SIGTERM 被杀属于 clean exit，systemd 不会拉起 —— 任何一次误 kill 都会造成生产中断。
# 与受控端模板 agent-go/diting-agent.service 的 Restart=always 对齐。
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
