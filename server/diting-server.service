[Unit]
Description=diting monitor server
After=network.target

[Service]
Type=simple
User=feng
# 运行目录分离（L2，2026-11-12）：运行副本与配置均在仓库树外——
#   代码+依赖+构建产物 = /data/simple-probe-data/server-data/app（`diting.sh --deploy-server` 同步）
#   配置 .env          = /data/simple-probe-data/server-data/.env（0600）
# `-` 前缀表示文件缺失时不阻断启动（server.js 的 dotenv 仍有兜底）。
EnvironmentFile=-/data/simple-probe-data/server-data/.env
# DITING_ENV_FILE（P0-1）：让 server.js 的 dotenv 回退与 .env 权限自检（server.js:194）
# 拿到真实环境文件路径。不设时自检退到运行副本目录 app/.env（不存在）→ 被 catch
# 静默跳过，权限过松告警永不触发。
Environment=DITING_ENV_FILE=/data/simple-probe-data/server-data/.env
WorkingDirectory=/data/simple-probe-data/server-data/app
ExecStart=/usr/local/bin/node server.js
# Restart=always（2026-10-26 由 on-failure 改）：on-failure 只覆盖「非零退出」，
# 而 SIGTERM 被杀属于 clean exit，systemd 不会拉起 —— 任何一次误 kill 都会造成生产中断。
# 与受控端模板 agent-go/diting-agent.service 的 Restart=always 对齐。
Restart=always
RestartSec=3
NoNewPrivileges=true
# P2-6 加固：运行副本/配置/库/备份分别在 /data 与 /var/backups，写路径不涉 /usr /etc /home
ProtectSystem=strict
# strict = 整个文件系统只读（仅豁免 /dev、/proc、/sys）——必须显式放行写路径，
# 否则 SQLite 写库报 "attempt to write a readonly database"（2026-11-13 线上事故实证）
ReadWritePaths=/data/simple-probe-data/server-data -/var/backups/diting
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
