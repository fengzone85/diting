[Unit]
Description=Diting Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diting
Group=diting
EnvironmentFile=/etc/diting/agent.env
ExecStart=/usr/bin/python3 /opt/diting/agent.py
WorkingDirectory=/opt/diting
SyslogIdentifier=diting-agent
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=10s

# ping 需要 CAP_NET_RAW。NoNewPrivileges=true 下文件 capabilities 会被忽略，
# 必须用 AmbientCapabilities 把能力真正传进进程（体检 L-12）。
# CapabilityBoundingSet 同步收窄，防止 Ambient 之外的隐式能力。
# Docker 形态的等价项是 --cap-add=NET_RAW（保持不变）。
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# ── Security hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/diting
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
LockPersonality=true
# AF_ prefixed names are supported by all systemd versions (e.g. Debian 12 = 252).
# The short forms "inet/inet6/unix" only work on systemd >= 254 and are silently
# ignored (with a journal warning that drops the whole restriction) on older ones.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
